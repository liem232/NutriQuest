rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(field) {
      return signedIn() && field == request.auth.uid;
    }

    function isBlocked() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_blocked == true;
    }

    // Public catalogs
    match /product_categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if !isBlocked() && (resource.data.is_approved == true || isAdmin() || (signedIn() && resource.data.added_by == request.auth.uid));

      allow create: if isAdmin();

      allow update, delete: if isAdmin();
    }

    // Profiles
    match /profiles/{uid} {
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow create: if signedIn() && uid == request.auth.uid;
      allow update: if isAdmin() || (!isBlocked() && signedIn() && uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Diary
    match /food_diary/{id} {
      allow read: if !isBlocked() && signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isAdmin();
      allow update, delete: if !isBlocked() && signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Daily stats
    match /daily_stats/{id} {
      allow read: if !isBlocked() && signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if !isBlocked() && signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if !isBlocked() && signedIn() && resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Achievements
    match /achievements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_achievements/{id} {
      allow read: if isAdmin() || (!isBlocked() && signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isAdmin() || (!isBlocked() && signedIn() && request.resource.data.user_id == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /user_roles/{uid} {
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /activity_events/{id} {
      allow read: if isAdmin();
      allow create: if !isBlocked() && signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /meta/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
